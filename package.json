{
  "name": "codex-bible-study-app",
  "version": "12.0.0",
  "private": true,
  "description": "CODEX Bible-study PWA — offline-first scripture intelligence terminal. Monorepo: packages/* + apps/*. The web app still ships a committed build so it runs with zero install (fork & go).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build-jsx.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json"
  },
  "devDependencies": {
    "@babel/standalone": "7.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^8.1.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zustand": "^5.0.14"
  }
}
